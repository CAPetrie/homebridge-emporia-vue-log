{
  "pluginAlias": "EmporiaVuePowerLog",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "Emporia-Vue Power Log"
      },
      "emporiaVueUsername": {
        "title": "Emporia Vue Username",
        "type": "string",
        "required": true,
        "default": ""
      },
      "emporiaVuePassword": {
        "title": "Emporia Vue Password",
        "type": "string",
        "required": true,
        "default": ""
      },
      "emporiaVueChannelName": {
        "title": "Emporia Vue Channel Name (put '1,2,3')",
        "type": "string",
        "required": true,
        "default": "1,2,3"
      },
      "refreshIntervalMinutes": {
        "title": "Refresh Interval (1-59 minutes)",
        "type": "number",
        "required": true,
        "default": 1
      },
      "printInterval": {
        "title": "Print Interval (number of datapoint to store before printing)",
        "type": "number",
        "required": true,
        "default": 10
      }
    }
  }
}
